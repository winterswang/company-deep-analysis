if __name__ == "__main__":
    import argparse
    
    parser = argparse.ArgumentParser(description="分析引擎测试")
    parser.add_argument("--company", default="贵州茅台", help="公司名称")
    parser.add_argument("--stock", default="600519", help="股票代码")
    parser.add_argument("--dir", default="/tmp/company_analysis", help="data-collector 输出目录")
    
    args = parser.parse_args()
    
    # 运行分析
    engine = AnalysisEngine(args.dir)
    result = engine.analyze(args.company, args.stock)
    
    # 输出结果
    print(json.dumps(result.to_dict(), ensure_ascii=False, indent=2))